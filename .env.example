# Bu dosyayı sunucuda `.env` olarak kopyalayıp elle doldurun.
# Gerçek .env repoya GİRMEZ (.gitignore -> .env*).

# --- Veritabanı ---
# Postgres container'ının kimlik bilgileri. docker-compose.yml hem db servisini
# hem de DATABASE_URL'i bunlardan üretir.
POSTGRES_USER="fitness"
POSTGRES_PASSWORD=""          # zorunlu — güçlü bir şifre üretin
POSTGRES_DB="fitness"

# Yerel geliştirme için (host'tan bağlanırken). Sunucuda docker-compose
# DATABASE_URL'i kendisi kurduğu için bu satır gerekmez.
DATABASE_URL="postgresql://fitness:degistir@localhost:5433/fitness?schema=public"

# --- Auth.js v5 ---
# openssl rand -base64 32
AUTH_SECRET=""

# Ortak proxy'nin sunduğu genel adres. Auth.js callback URL'lerini bundan üretir.
AUTH_URL="https://fitness.senindomainin.com"

# Proxy arkasında olduğumuzu bildirir: şema ve host X-Forwarded-Proto /
# X-Forwarded-Host header'larından okunur. Proxy arkasında her zaman true.
AUTH_TRUST_HOST="true"

# --- İlk admin hesabı ---
# Sadece `docker compose run --rm tools npm run seed:admin` çalıştırılırken okunur.
# Hesap oluştuktan sonra bu satırları silebilirsiniz.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""             # en az 8 karakter
ADMIN_NAME="Admin"
